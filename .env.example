# Run make configure to generate LOCAL DEVELOPMENT credentials.
ENV=dev
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://modelledger:SET_PASSWORD@localhost:5432/modelledger
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CONTRACT_ADDRESS=
ISSUER_KEY=
GATEWAY_KEY=
REGISTRAR_KEY=
DEV_API_KEY=
PUBLIC_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
ALLOW_SIMULATED=false
ENABLE_DEMO=false
RATE_LIMIT_PER_MINUTE=60
# Contract deployment only; ignored by the backend:
TESTNET_RPC_URL=
DEPLOYER_KEY=

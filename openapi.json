  "components": {
    "schemas": {
      "ActorIn": {
        "properties": {
          "actor_id": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$",
            "title": "Actor Id"
          },
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "provider": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Provider"
          },
          "kind": {
            "type": "string",
            "enum": [
              "MODEL",
              "TOOL",
              "HUMAN",
              "PLATFORM"
            ],
            "title": "Kind"
          },
          "signature": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{130}$",
            "title": "Signature"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "actor_id",
          "name",
          "provider",
          "kind",
          "signature"
        ],
        "title": "ActorIn"
      },
      "AdminIn": {
        "properties": {
          "effective_from": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Effective From"
          },
          "raw_transaction": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 8192,
                "pattern": "^0x[0-9a-fA-F]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw Transaction"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "AdminIn"
      },
      "Body_register_api_v1_register_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "declared_origin": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Declared Origin"
          },
          "save_thumbnail": {
            "type": "boolean",
            "title": "Save Thumbnail",
            "default": false
          },
          "signed_event": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32768
              },
              {
                "type": "null"
              }
            ],
            "title": "Signed Event"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_register_api_v1_register_post"
      },
      "Body_transform_api_v1_transform_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "operations": {
            "type": "string",
            "maxLength": 8192,
            "title": "Operations"
          }
        },
        "type": "object",
        "required": [
          "file",
          "operations"
        ],
        "title": "Body_transform_api_v1_transform_post"
      },
      "Body_verify_file_api_v1_verify_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "save_history": {
            "type": "boolean",
            "title": "Save History",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_verify_file_api_v1_verify_post"
      },
      "CorroborationIn": {
        "properties": {
          "kind": {
            "type": "integer",
            "maximum": 3.0,
            "minimum": 1.0,
            "title": "Kind"
          },
          "evidence": {
            "$ref": "#/components/schemas/Evidence"
          },
          "signature": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{130}$",
            "title": "Signature"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "evidence",
          "signature"
        ],
        "title": "CorroborationIn"
      },
      "Counts": {
        "properties": {
          "verified": {
            "type": "integer",
            "title": "Verified"
          },
          "unverified": {
            "type": "integer",
            "title": "Unverified"
          },
          "gaps": {
            "type": "integer",
            "title": "Gaps"
          },
          "conflicts": {
            "type": "integer",
            "title": "Conflicts"
          },
          "tamper_warnings": {
            "type": "integer",
            "title": "Tamper Warnings"
          }
        },
        "type": "object",
        "required": [
          "verified",
          "unverified",
          "gaps",
          "conflicts",
          "tamper_warnings"
        ],
        "title": "Counts"
      },
      "DisclosureIn": {
        "properties": {
          "event_hash": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$",
            "title": "Event Hash"
          },
          "field": {
            "type": "string",
            "maxLength": 40,
            "title": "Field"
          },
          "value": {
            "type": "string",
            "maxLength": 16384,
            "title": "Value"
          },
          "salt": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{32}$",
            "title": "Salt"
          },
          "proof": {
            "items": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{64}$"

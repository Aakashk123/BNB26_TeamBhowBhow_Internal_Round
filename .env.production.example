# Copy to .env.production and configure a real domain, external chain, and fresh keys.
ENV=production
DOMAIN=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://modelledger:SET_PASSWORD@postgres:5432/modelledger
PUBLIC_URL=https://YOUR_DOMAIN
CORS_ORIGINS=https://YOUR_DOMAIN
CHAIN_RPC_URL=
CHAIN_ID=84532
CONTRACT_ADDRESS=
ISSUER_KEY=
GATEWAY_KEY=
REGISTRAR_KEY=
DEV_API_KEY=
ALLOW_SIMULATED=false
ENABLE_DEMO=false
RATE_LIMIT_PER_MINUTE=120
